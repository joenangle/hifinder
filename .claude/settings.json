{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/git-push-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking push target"
          }
        ]
      }
    ]
  }
}
