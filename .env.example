# Copy to .env.local and fill in. Never commit real values.
# Production/preview values live in Vercel; scraper values in GitHub Actions secrets.

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Secret key (sb_secret_...). Server-only: bypasses RLS. Use one key per backend.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# Direct Postgres access for `npm run db` (scripts/run-sql.js)
SUPABASE_DB_PASSWORD=your-db-password
DATABASE_URL=postgresql://postgres.your-project-ref@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# --- Auth (NextAuth + Google OAuth) ---------------------------------------
NEXTAUTH_URL=http://localhost:3002
# At least 32 characters in production: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Server-only. The Google account with this (verified) email gets admin.
ADMIN_EMAIL=you@example.com

# --- Site -----------------------------------------------------------------
# Used in email links and by scripts/warm-cache.js; defaults to https://hifinder.app
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_DONATE_URL=
NEXT_PUBLIC_EBAY_CAMPAIGN_ID=
# staging.hifinder.app Basic Auth password (set in Vercel for staging only)
STAGING_PASSWORD=

# --- Email + cron ---------------------------------------------------------
RESEND_API_KEY=re_xxx
# Bearer token for /api/alerts/* and /api/cache/invalidate; also signs
# unsubscribe links. Must match Vercel and the GitHub Actions secret.
CRON_SECRET=your-cron-secret

# --- Scrapers -------------------------------------------------------------
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REVERB_API_TOKEN=your-reverb-token
# SCRAPER_VERBOSE=1
